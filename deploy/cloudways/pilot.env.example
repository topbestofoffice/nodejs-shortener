# Render this template into a private ignored file. Never put real values here.
NODE_ENV=production
APP_PRIVATE_ROOT=__APP_PRIVATE_ROOT_ABSOLUTE_PATH__
APP_RELEASE_ROOT=__APP_RELEASE_ROOT_ABSOLUTE_PATH__
NODE_BINARY=__ABSOLUTE_NODE_BINARY__
APP_NAMESPACE=__UNIQUE_APP_NAMESPACE__
HOST=127.0.0.1
PORT=__UNIQUE_LOOPBACK_PORT__
LOG_LEVEL=info
DOMAIN_CONFIG_FILE=./config/__EXACT_DOMAIN_CONFIG_FILE__.json

# Exact target-bound activation. Values come from the existing readiness
# workflow; this package does not generate them.
NODE_SHORTENER_DEPLOYMENT_STAGE=pilot
NODE_SHORTENER_DEPLOYMENT_TARGET_ID=__EXACT_CLOUDWAYS_DEPLOYMENT_TARGET_ID__
NODE_SHORTENER_PRODUCTION_ACTIVATION_FILE=private/activation/__EXACT_PILOT_ACTIVATION_FILE__.json
NODE_SHORTENER_PRODUCTION_ACTIVATION_SHA256=__EXACT_64_HEX_ACTIVATION_SHA256__

# Enable Cloudflare identity only after the duplicate/spoof proof is captured.
TRUST_PROXY=loopback
TRUST_CLOUDFLARE_HEADERS=false
CLOUDFLARE_HEADER_SANITIZATION_VERIFIED=false
PROXY_CHAIN_VERIFIED=true
ORIGIN_AUTH_ENABLED=true
ORIGIN_AUTH_HEADER=x-shortener-origin-auth
ORIGIN_AUTH_SHA256=__PRIVATE_ORIGIN_AUTH_SHA256__

STORAGE_DRIVER=mysql
MYSQL_HOST=__PRIVATE_MYSQL_HOST__
MYSQL_PORT=__PRIVATE_MYSQL_PORT__
MYSQL_DATABASE=__UNIQUE_MYSQL_DATABASE__
MYSQL_USER=__UNIQUE_MYSQL_USER__
MYSQL_PASSWORD=__PRIVATE_MYSQL_PASSWORD__
MYSQL_CONNECTION_LIMIT=4
MYSQL_QUEUE_LIMIT=64

REDIS_URL=__PRIVATE_REDIS_URL__
REDIS_KEY_PREFIX=__UNIQUE_REDIS_KEY_PREFIX__
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=200
DELIVERED_COUNTRY_DOMAIN_IDS=

IP_HASH_SECRET=__PRIVATE_32_PLUS_CHARACTER_IP_HASH_SECRET__
COOKIE_SIGNING_SECRET=__PRIVATE_32_PLUS_CHARACTER_COOKIE_SIGNING_SECRET__
SESSION_TTL_SECONDS=2592000

PM2_PROCESS_PREFIX=__UNIQUE_PM2_PROCESS_PREFIX__
PM2_HOME=__PRIVATE_PM2_HOME_ABSOLUTE_PATH__
PM2_CLI_SCRIPT=__ABSOLUTE_PM2_CLI_SCRIPT__
PM2_VERSION=__EXACT_PM2_VERSION__
WEB_INSTANCES=1
WEB_MAX_MEMORY_MB=384
IMAGE_WORKER_MAX_MEMORY_MB=512
IMAGE_RECOVERY_PREFLIGHT_TIMEOUT_MS=5000

CODE_LENGTH=6
MAX_BULK_LINKS=100
MAX_BULK_IMAGES=100
BROWSER_SCOPED_DEFAULT_USERS=

IMAGE_EXECUTOR=bullmq
PRIVATE_TEMP_DIR=__PRIVATE_HTML_TEMP_ABSOLUTE_PATH__
PUBLIC_UPLOAD_DIR=__PUBLIC_HTML_UPLOADS_ABSOLUTE_PATH__
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=20000000
MAX_READY_UPLOADS_PER_SESSION=100
MAX_READY_UPLOADS_TOTAL=1000
UPLOAD_OWNERSHIP_TTL_SECONDS=86400
IMAGE_JOB_TIMEOUT_MS=30000
SERVE_STATIC_UPLOADS=false

# Production must never seed accounts.
DEV_SEED_USERNAME=
DEV_SEED_PASSWORD=

REDIRECT_ENGINE=current
DATACENTER_RANGES_FILE=./data/datacenter-ranges.json

# Enable only for the short token-protected header capture, then disable.
PILOT_HEADER_DIAGNOSTICS=false
PILOT_DIAGNOSTIC_TOKEN_SHA256=__PRIVATE_DIAGNOSTIC_TOKEN_SHA256_WHEN_ENABLED__
ANALYTICS_MEASUREMENT_ID=
ANALYTICS_SITE_KEY=
