{
  "name": "nodejs-shortener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single- and multi-domain Node.js shortener parity pilot",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "activation:create": "node tools/generate-production-activation.mjs --activate",
    "activation:plan": "node tools/generate-production-activation.mjs --plan",
    "benchmark:http": "node tools/http-benchmark.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run check:scripts && npm run test:run",
    "check:scripts": "node tools/verify-script-syntax.mjs",
    "dev": "tsx watch src/server.ts",
    "dev:browser-fixture": "node tools/browser-fixture-server.mjs",
    "lint": "eslint src test vitest.config.ts",
    "maintenance:report": "npm run build && node tools/maintenance-report.mjs",
    "inventory:pm2:safe": "node tools/safe-pm2-inventory.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/image-worker.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:local": "node tools/smoke-local.mjs",
    "smoke:single-local": "node tools/smoke-single-local.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:evidence": "node tools/verify-php-evidence.mjs",
    "verify:authority": "node tools/verify-parity-authority.mjs",
    "verify:cloudways-package": "node tools/verify-cloudways-package.mjs",
    "verify:cloudways-installed": "node tools/verify-cloudways-installed.mjs",
    "verify:schema:snapshot": "node tools/verify-schema-contract.mjs --snapshot=evidence/current-schema-sanitized.json --target-id=historical-cloudways-php-capture-2026-08-23",
    "verify:schema:database": "node tools/verify-schema-contract.mjs --database",
    "verify:pm2": "node tools/verify-pm2-config.cjs",
    "verify:local": "node tools/verify-local.mjs",
    "verify:pilot-candidate": "node tools/verify-production-readiness.mjs --stage=pilot",
    "verify:readiness": "node tools/verify-production-readiness.mjs",
    "verify:release": "node tools/verify-release.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@node-rs/argon2": "2.1.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.2.0",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "mysql2": "3.23.4",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.0.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
