NODE_ENV=development
APP_NAMESPACE=node-shortener-local
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DOMAIN_CONFIG_FILE=./config/domains.local.json

# Keep false until the exact Cloudways proxy chain has been captured on the pilot.
TRUST_PROXY=false
TRUST_CLOUDFLARE_HEADERS=false
# Keep false until direct-origin plus duplicate/spoofed CF header tests pass.
CLOUDFLARE_HEADER_SANITIZATION_VERIFIED=false
PROXY_CHAIN_VERIFIED=false

# Production must set a private random header value and its header name.
ORIGIN_AUTH_ENABLED=false
ORIGIN_AUTH_HEADER=x-shortener-origin-auth
ORIGIN_AUTH_SHA256=

STORAGE_DRIVER=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shortener
MYSQL_USER=shortener
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=4
MYSQL_QUEUE_LIMIT=64

REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=node-shortener-local
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=200

# Explicit observer activation. Keep empty until the exact domain's singleton
# private Delivered publisher and rollback contract are proven on the pilot.
DELIVERED_COUNTRY_DOMAIN_IDS=

IP_HASH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SIGNING_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000

# PM2/runtime values are sanitized and bound into the production activation.
# Use a different prefix for every concurrently installed shortener project.
PM2_PROCESS_PREFIX=shortener
WEB_INSTANCES=1
WEB_MAX_MEMORY_MB=384
IMAGE_WORKER_MAX_MEMORY_MB=512
IMAGE_RECOVERY_PREFLIGHT_TIMEOUT_MS=5000

# Explicit application limits. Reconcile these against the exact PHP pilot
# schema/config before activation; the checked values match the clean portable baseline.
CODE_LENGTH=6
MAX_BULK_LINKS=100
MAX_BULK_IMAGES=100

# Optional exact private identity tuple(s) whose default domain remains browser-local,
# for example: 8:shared-author:user,21:another-shared-author:user
BROWSER_SCOPED_DEFAULT_USERS=

IMAGE_EXECUTOR=inline
PRIVATE_TEMP_DIR=./private/tmp
PUBLIC_UPLOAD_DIR=./public/uploads
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=20000000
MAX_READY_UPLOADS_PER_SESSION=100
MAX_READY_UPLOADS_TOTAL=1000
UPLOAD_OWNERSHIP_TTL_SECONDS=86400
IMAGE_JOB_TIMEOUT_MS=30000
# Keep false on Cloudways when public_html/uploads is excluded from the Node proxy.
SERVE_STATIC_UPLOADS=false

# Optional only in local in-memory mode. Never set these in production.
DEV_SEED_USERNAME=
DEV_SEED_PASSWORD=

# Passthrough is safe for local scaffolding only. Production startup rejects it.
REDIRECT_ENGINE=passthrough
DATACENTER_RANGES_FILE=./data/datacenter-ranges.json

# Temporary pilot-only endpoint. Disable before any live-traffic switch.
PILOT_HEADER_DIAGNOSTICS=false
PILOT_DIAGNOSTIC_TOKEN_SHA256=

# Optional privacy-bounded dashboard GA4/RUM. Supply both or leave both empty.
# Automatic page views, raw URLs, account IDs and exact timings are never sent.
ANALYTICS_MEASUREMENT_ID=
ANALYTICS_SITE_KEY=
